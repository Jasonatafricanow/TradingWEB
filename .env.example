# ==================== 数据库配置（MySQL — 主数据库） ====================
# Drizzle ORM 通过 mysql2 连接，所有业务数据存放在此
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tradingweb
DB_PORT=3306

# ==================== JWT 密钥 ====================
# 用于本地认证系统签发和验证 JWT token
# 生产环境务必改为强随机字符串
JWT_SECRET=dev-jwt-secret-do-not-use-in-production
JWT_EXPIRY=7d

# ==================== 站点 URL（支付回调/跳转使用） ====================
# 本地开发: http://localhost:5000
# 服务器测试/生产: https://你的域名
NEXT_PUBLIC_SITE_URL=http://localhost:5000

# ==================== 支付配置 ====================
# PayPal — 从 https://developer.paypal.com/dashboard 获取
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
# PayPal webhook 公网 HTTPS 地址应配置为: ${NEXT_PUBLIC_SITE_URL}/api/payment/webhook
# 本地 callback 流程可先不填；服务器 webhook 测试/生产必须填 PayPal 后台生成的 Webhook ID
PAYPAL_WEBHOOK_ID=

# Stripe — 从 https://dashboard.stripe.com/apikeys 获取
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_SANDBOX=true

# Webhook 共享密钥（自托管验证用）
WEBHOOK_SECRET=
# 仅允许 localhost 调试无签名 webhook；公开测试/生产环境必须保持 false
ALLOW_UNSIGNED_WEBHOOKS=false
# 仅当应用前面有可信反向代理且代理会覆盖客户端 IP 头时开启
TRUST_PROXY_HEADERS=false

# ==================== 定时任务与多货币汇率 ====================
# 用于保护 /api/cron/* 定时任务；生产环境务必改为强随机字符串
CRON_SECRET=
# USD 基准每日汇率来源；默认使用 ExchangeRate-API open endpoint
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# IP 货币识别兜底来源；{ip} 会被服务端替换为访客 IP
IP_GEOLOCATION_API_URL=https://ipapi.co/{ip}/json/

# Google OAuth
# 从 https://console.cloud.google.com/apis/credentials 获取
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In
# 需要 Apple Developer Program 会员
NEXT_PUBLIC_APPLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=

# ==================== AWS S3（文件上传 — 可选） ====================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
# 可选：CloudFront/R2/自定义公开域名；不填时使用标准 S3 公网 URL
AWS_S3_PUBLIC_BASE_URL=
# 可选：S3 兼容服务（如 MinIO/R2）端点
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
# 可选：未配置 S3 时的本地持久化目录。生产环境如不用 S3，必须显式设置。
MEDIA_UPLOAD_DIR=

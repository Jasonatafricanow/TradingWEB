{
    "name": "tradingweb",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "bash ./scripts/build.sh",
        "dev": "bash ./scripts/dev.sh",
        "lint": "eslint",
        "lint:build": "eslint . --quiet",
        "preinstall": "npx only-allow pnpm",
        "start": "bash ./scripts/start.sh",
        "test-db": "npx tsx src/lib/db-test.ts",
        "test:e2e": "playwright test",
        "test:e2e:report": "playwright show-report",
        "test:e2e:ui": "playwright test --ui",
        "migration:reconcile": "tsx scripts/migration-reconciliation/cli.ts",
        "test:migration-reconciliation:integration": "tsx scripts/migration-reconciliation/integration/run.ts",
        "test:migration-reconciliation:replay-full": "tsx scripts/migration-reconciliation/integration/run.ts replay-full",
        "ts-check": "tsc -p tsconfig.json",
        "test": "vitest run",
        "i18n:check": "tsx scripts/i18n-hardcoded.ts",
        "validate": "pnpm run --parallel '/^(ts-check|lint:build|i18n:check)$/'"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.958.0",
